# MasonArt E-Commerce Platform - Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL database connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://poster_app:dev_password@localhost:5433/poster_app_dev

# Redis connection string for caching, sessions, and queues
# Format: redis://[host]:[port]
REDIS_URL=redis://localhost:6380

# =============================================================================
# STORAGE CONFIGURATION (Cloudflare R2 / AWS S3)
# =============================================================================
# Cloudflare R2 or AWS S3 endpoint URL
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# R2/S3 access credentials
R2_ACCESS_KEY=your-r2-access-key-here
R2_SECRET_KEY=your-r2-secret-key-here

# Bucket name for storing images and AI generations
R2_BUCKET=masonart-storage

# CDN URL for serving static assets (optional)
# If using Cloudflare R2 with public domain
CDN_URL=https://cdn.masonart.com

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================
# Secret key for Better Auth session encryption
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-32-character-or-longer-secret-key-here

# Google OAuth credentials (optional, for social login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# PAYMENT GATEWAY (Razorpay)
# =============================================================================
# Razorpay API credentials
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Razorpay webhook secret for payment verification
# Get from: https://dashboard.razorpay.com/app/webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# =============================================================================
# AI SERVICE (Replicate)
# =============================================================================
# Replicate API token for AI image generation
# Get from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your_replicate_token_here

# =============================================================================
# EMAIL SERVICE (Resend)
# =============================================================================
# Resend API key for transactional emails
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# =============================================================================
# FRONTEND CONFIGURATION (VITE)
# =============================================================================
# API server URL for frontend API calls (optional in development)
# In development, can use relative URLs
VITE_API_URL=http://localhost:3000

# CDN URL for frontend asset references (optional)
VITE_CDN_URL=https://cdn.masonart.com

# =============================================================================
# ADDITIONAL CONFIGURATION (Optional)
# =============================================================================
# Node environment (development, production, test)
NODE_ENV=development

# API server port
PORT=3000

# Frontend dev server port
VITE_PORT=3001

# Enable debug logging (true/false)
DEBUG=false

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================
# 1. Never commit your actual .env file to version control
# 2. Use strong, unique secrets for production environments
# 3. Rotate secrets regularly
# 4. Use environment-specific values (dev, staging, prod)
# 5. See docs/poster-app-tech-stack.md for detailed configuration guide
