# =============================================================================
# Poster & Frame E-Commerce Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Connection URL for PostgreSQL database
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://poster_app:dev_password@localhost:5432/poster_app_dev
# Connection pool settings (optional, defaults shown)
# DB_POOL_MAX=20
# DB_POOL_IDLE_TIMEOUT=10
# DB_POOL_CONNECT_TIMEOUT=30

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Connection URL for Redis (used for caching, sessions, and job queues)
# Format: redis://USER:PASSWORD@HOST:PORT or redis://HOST:PORT
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------
# Allowed origin(s) for API requests. REQUIRED in production.
# Supports comma-separated list for multiple origins.
# Development: http://localhost:3001
# Production: https://chobi.art,https://www.chobi.art
CORS_ORIGIN=http://localhost:3001

# -----------------------------------------------------------------------------
# Error Tracking (Sentry) — Optional
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking. Leave empty to disable.
# API uses SENTRY_DSN, Web uses VITE_SENTRY_DSN
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Log level: fatal, error, warn, info, debug, trace
# Default: info in production, debug in development
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Alerting (Slack) — Optional
# -----------------------------------------------------------------------------
# Slack incoming webhook URL for critical error alerts
# Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Authentication (Better Auth)
# -----------------------------------------------------------------------------
# Secret key for signing auth tokens (generate a secure random string in production)
BETTER_AUTH_SECRET=your-secret-key-change-in-production

# Google OAuth (optional - for social login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# Storage (S3-compatible - MinIO for dev, Cloudflare R2 for production)
# -----------------------------------------------------------------------------
# S3-compatible storage endpoint
R2_ENDPOINT=http://localhost:9000
# Access credentials
R2_ACCESS_KEY=minioadmin
R2_SECRET_KEY=minioadmin
# Bucket name for storing images
R2_BUCKET=poster-app-dev
# CDN URL for serving images (same as endpoint for local dev)
CDN_URL=http://localhost:9000/poster-app-dev

# -----------------------------------------------------------------------------
# AI Generation
# -----------------------------------------------------------------------------
# Replicate API token (for Stable Diffusion)
# Get one at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your-replicate-api-token

# Google AI Studio API key (for Gemini image generation)
# Get one at: https://aistudio.google.com/app/apikey
GOOGLE_AI_STUDIO_KEY=your-google-ai-studio-key

# OpenAI API key (for DALL-E 3) - optional
# OPENAI_API_KEY=your-openai-api-key

# FAL.ai API key (for FLUX models) - optional
# FAL_API_KEY=your-fal-api-key

# -----------------------------------------------------------------------------
# SMS OTP (2Factor.in)
# -----------------------------------------------------------------------------
# API key for 2Factor.in SMS OTP service
# Get one at: https://2factor.in/ (Free trial available)
# In development, leave empty to use mock OTP (use "123456" to verify)
TWO_FACTOR_API_KEY=your-2factor-api-key

# OTP template name registered in 2Factor.in dashboard
# This must be DLT compliant for India
TWO_FACTOR_OTP_TEMPLATE=MasonArt

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# API key for Resend (transactional emails)
# Get one at: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Email sender address
EMAIL_FROM=noreply@yourstore.com

# -----------------------------------------------------------------------------
# Payments (Razorpay)
# -----------------------------------------------------------------------------
# Razorpay API credentials
# Get these at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Webhook secret for verifying Razorpay webhook signatures
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# API URL for the frontend to connect to
VITE_API_URL=http://localhost:3000
# CDN URL for serving images on frontend
VITE_CDN_URL=http://localhost:9000/poster-app-dev

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# API server port
API_PORT=3000
# Web server port
WEB_PORT=3001
# Node environment
NODE_ENV=development

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Application name (used in emails, meta tags, etc.)
APP_NAME=MasonArt
# Base URL for the web application
APP_URL=http://localhost:3001
