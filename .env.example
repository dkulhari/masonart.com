# =============================================================================
# Poster & Frame E-Commerce Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Connection URL for PostgreSQL database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# THIS IS THE SINGLE PLACE THE DEV DATABASE IS CONFIGURED. Everything derives
# from it — the app, vitest, the scripts, and docker-compose's published port
# (via POSTGRES_PORT). Nothing has a port fallback: this machine also runs
# other projects' postgres on 5432 and 5433, and guessing silently connects to
# the wrong server. See packages/api/src/config/database-url.ts.
DATABASE_URL=postgresql://poster_app:dev_password@localhost:5440/poster_app_dev
# Disposable database for tests.
#
# Two sets of suites read it:
#  - DESTRUCTIVE suites (tests/database/) DROP and recreate tables, and skip
#    unless this points at a database whose name ends in `_test` — see
#    packages/api/tests/helpers/destructive-db.ts (#332).
#  - The gift card suites open a real connection to assert a row lock, a unique
#    constraint settling a race, and transactional rollback. They prefer this
#    over DATABASE_URL when set, and FAIL rather than skip when no database is
#    reachable at all — packages/api/tests/helpers/live-db.ts (#580). Set
#    ALLOW_MISSING_DB=true to skip them out loud instead.
#
# When set, the whole vitest run uses it (tests/setup.ts), so fixtures and the
# code under test agree about which database they are talking to.
#
# One-time setup:
#   psql -c "CREATE DATABASE poster_app_test OWNER poster_app;"
#   cd packages/api && DATABASE_URL=<the _test url> bunx drizzle-kit migrate
# TEST_DATABASE_URL=postgresql://poster_app:dev_password@localhost:5440/poster_app_test
# Connection pool settings (optional, defaults shown)
# DB_POOL_MAX=20
# DB_POOL_IDLE_TIMEOUT=10
# DB_POOL_CONNECT_TIMEOUT=30

# Rate limiting bypass for test environments ONLY — the E2E auth setup makes
# more auth POSTs per run than the sliding window allows. Ignored whenever
# NODE_ENV=production (see packages/api/src/middleware/rate-limit.ts, #332).
# DISABLE_RATE_LIMIT=true

# Auth emails (verification, password reset) always send in production but
# are logged instead outside it — dev signups use fake addresses and the dev
# .env may carry a real Resend key. Opt in to real sends locally (#342):
# SEND_AUTH_EMAILS=true

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Connection URL for Redis (used for caching, sessions, and job queues)
# Format: redis://USER:PASSWORD@HOST:PORT or redis://HOST:PORT
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------
# Allowed origin(s) for API requests. REQUIRED in production.
# Supports comma-separated list for multiple origins.
# Development: http://localhost:3001
# Production: https://chobii.art,https://www.chobii.art
CORS_ORIGIN=http://localhost:3001

# -----------------------------------------------------------------------------
# Error Tracking (Sentry) — Optional
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking. Leave empty to disable.
# API uses SENTRY_DSN, Web uses VITE_SENTRY_DSN
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Log level: fatal, error, warn, info, debug, trace
# Default: info in production, debug in development
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Audit log
# -----------------------------------------------------------------------------
# How many days admin_audit_log rows are kept before the daily purge removes
# them. Rows carry customer emails and staff identity, so this is a DPDP Act
# retention decision, not a disk-space one.
# Default: 400 (a financial year plus the disputes that trail it).
# A value below 1, or anything unparseable, falls back to the default — "0"
# would mean delete everything, and the table has no other copy.
AUDIT_RETENTION_DAYS=400

# -----------------------------------------------------------------------------
# QC photograph retention
# -----------------------------------------------------------------------------
# How many days production_job_photos rows and their production-qc/ objects in
# R2 are kept before the daily sweep removes them.
# Default: 400 — deliberately the SAME number as AUDIT_RETENTION_DAYS above.
# The QC verdict is an audit row and the photograph is its evidence; if these
# two drift, one expires first and the survivor is worthless.
# Same fallback rule: below 1, or unparseable, falls back to the default.
# The sweep deletes the R2 objects BEFORE the rows, because the row is the only
# handle on the object.
QC_PHOTO_RETENTION_DAYS=400

# -----------------------------------------------------------------------------
# Alerting (Slack) — Optional
# -----------------------------------------------------------------------------
# Slack incoming webhook URL for critical error alerts
# Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Authentication (Better Auth)
# -----------------------------------------------------------------------------
# Secret key for signing auth tokens (generate a secure random string in production)
BETTER_AUTH_SECRET=your-secret-key-change-in-production

# Google OAuth (optional - for social login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# Storage (S3-compatible - MinIO for dev, Cloudflare R2 for production)
# -----------------------------------------------------------------------------
# S3-compatible storage endpoint
R2_ENDPOINT=http://localhost:9000
# Access credentials
R2_ACCESS_KEY=minioadmin
R2_SECRET_KEY=minioadmin
# Bucket name for storing images
R2_BUCKET=poster-app-dev
# CDN URL for serving images (same as endpoint for local dev)
CDN_URL=http://localhost:9000/poster-app-dev

# -----------------------------------------------------------------------------
# AI Generation
# -----------------------------------------------------------------------------
# Replicate API token (for Stable Diffusion)
# Get one at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your-replicate-api-token

# Google AI Studio API key (for Gemini image generation)
# Get one at: https://aistudio.google.com/app/apikey
GOOGLE_AI_STUDIO_KEY=your-google-ai-studio-key

# OpenAI API key (for DALL-E 3) - optional
# OPENAI_API_KEY=your-openai-api-key

# FAL.ai API key (for FLUX models) - optional
# FAL_API_KEY=your-fal-api-key

# -----------------------------------------------------------------------------
# SMS OTP (2Factor.in)
# -----------------------------------------------------------------------------
# API key for 2Factor.in SMS OTP service
# Get one at: https://2factor.in/ (Free trial available)
# In development, leave empty to use mock OTP (use "123456" to verify)
TWO_FACTOR_API_KEY=your-2factor-api-key

# OTP template name registered in 2Factor.in dashboard
# This must be DLT compliant for India
TWO_FACTOR_OTP_TEMPLATE=MasonArt  # legacy DLT template name registered with 2Factor.in

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# API key for Resend (transactional emails)
# Get one at: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Email sender address
EMAIL_FROM=noreply@yourstore.com

# -----------------------------------------------------------------------------
# Payments (Razorpay)
# -----------------------------------------------------------------------------
# Razorpay API credentials
# Get these at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Webhook secret for verifying Razorpay webhook signatures
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# -----------------------------------------------------------------------------
# Gift Cards
# -----------------------------------------------------------------------------
# Server-side pepper mixed into gift card code hashes. Only the hash and last
# four of a code are stored, and the pepper lives outside the database, so a
# leaked dump cannot be attacked offline with precomputed codes.
# REQUIRED in production — startup fails loudly rather than hashing every card
# with an empty pepper. Rotating it invalidates every existing card.
GIFT_CARD_CODE_PEPPER=

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# API URL for the frontend to connect to
VITE_API_URL=http://localhost:3000
# CDN URL for serving images on frontend
VITE_CDN_URL=http://localhost:9000/poster-app-dev

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# API server port
API_PORT=3000
# Web server port
WEB_PORT=3001
# Node environment
NODE_ENV=development

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Application name (used in emails, meta tags, etc.)
APP_NAME=chobii.art
# Base URL for the web application
APP_URL=http://localhost:3001
