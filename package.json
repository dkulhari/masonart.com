{
  "name": "chobii",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=2",
    "test:integration": "turbo run test:integration --concurrency=2",
    "test:e2e": "turbo run test:e2e --concurrency=2",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:reset": "./scripts/db-reset.sh",
    "db:reset:full": "./scripts/db-reset.sh --docker-reset"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "prettier": "^3.2.5",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "vitest": "^4.0.17"
  },
  "packageManager": "bun@1.1.38",
  "engines": {
    "node": ">=20.0.0"
  }
}
