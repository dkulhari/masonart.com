{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"]
    },
    "types": ["node"]
  },
  "include": ["app/**/*", "vite.config.ts", "app.config.ts", "tailwind.config.ts"],
  "exclude": ["node_modules", "dist", ".output", ".vinxi"]
}
