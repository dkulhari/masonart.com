{
  "name": "@chobii/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "DISABLE_RATE_LIMIT=true bun run --env-file=../../.env --hot src/index.ts",
    "build": "tsc",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "bun run --env-file=../../.env src/database/seed.ts",
    "seed:admin": "bun run --env-file=../../.env src/database/seed-admin.ts",
    "seed:test-users": "bun run --env-file=../../.env src/database/seed-test-users.ts",
    "backfill:art-box": "bun run --env-file=../../.env src/database/backfill-art-box.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@chobii/shared": "workspace:*",
    "@google/generative-ai": "^0.24.1",
    "@hono/zod-validator": "^0.4.1",
    "@sentry/node": "^10.39.0",
    "better-auth": "^1.2.0",
    "bullmq": "^5.30.0",
    "drizzle-orm": "^0.44.0",
    "drizzle-zod": "^0.8.0",
    "hono": "^4.6.12",
    "ioredis": "^5.4.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.5",
    "resend": "^6.9.1",
    "sharp": "^0.34.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.17",
    "drizzle-kit": "^0.31.0",
    "supertest": "^7.2.2",
    "typescript": "^5.6.3",
    "vitest": "^4.0.17"
  }
}
