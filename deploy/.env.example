# MasonArt production deploy contract — copy to deploy/.env and fill in.
# deploy/.env is gitignored and lives ONLY on the dev machine; values reach
# the mini solely baked into the rendered compose file. Vars marked
# (required) carry :? guards in docker/docker-compose.prod.yml — a missing
# value fails `make gen-compose` by design. See docs/EXTERNAL-SERVICES.md
# for where each credential comes from.

# ── Deploy target (the Mac mini) ─────────────────────────────────────
DEPLOY_USER=dhruv
DEPLOY_HOST=192.168.29.xxx        # static DHCP reservation — see RUNBOOK L1

# ── Public hostname (defaults to masonart.com in the compose file) ───
#PUBLIC_HOSTNAME=masonart.com

# ── Database ─────────────────────────────────────────────────────────
POSTGRES_PASSWORD=                # (required) openssl rand -hex 24
#POSTGRES_USER=masonart
#POSTGRES_DB=masonart

# ── Auth ─────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=               # (required) openssl rand -hex 32

# ── Razorpay (TEST MODE at launch — rzp_test_ keys) ──────────────────
RAZORPAY_KEY_ID=                  # (required)
RAZORPAY_KEY_SECRET=              # (required)
RAZORPAY_WEBHOOK_SECRET=          # (required) self-chosen: openssl rand -hex 32

# ── Email (Resend; domain must be verified first) ────────────────────
RESEND_API_KEY=                   # (required)
EMAIL_FROM=noreply@masonart.com   # (required)
#EMAIL_REPLY_TO=

# ── SMS (2Factor.in; DLT-approved sender + templates) ────────────────
TWO_FACTOR_API_KEY=               # (required)
#TWO_FACTOR_OTP_TEMPLATE=
#TWO_FACTOR_ORDER_CONFIRMED_TEMPLATE=
#TWO_FACTOR_SHIPPED_TEMPLATE=
#TWO_FACTOR_OUT_FOR_DELIVERY_TEMPLATE=
#TWO_FACTOR_DELIVERED_TEMPLATE=

# ── Cloudflare R2 + CDN ──────────────────────────────────────────────
R2_ENDPOINT=                      # (required) https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=                    # (required)
R2_SECRET_KEY=                    # (required)
R2_BUCKET=masonart-prod           # (required)
CDN_URL=https://cdn.masonart.com  # (required; also baked into web build)

# ── AI generation (at least ONE required — checked by make gen-compose) ──
REPLICATE_API_TOKEN=
GOOGLE_AI_STUDIO_KEY=
#FAL_API_KEY=
#OPENAI_API_KEY=

# ── OAuth (optional) ─────────────────────────────────────────────────
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# ── First-boot admin seed (used by make first-boot) ──────────────────
#SUPER_ADMIN_EMAIL=
#SUPER_ADMIN_PASSWORD=

# ── Observability (optional but strongly recommended) ────────────────
#SENTRY_DSN=                      # api project DSN
#VITE_SENTRY_DSN=                 # web project DSN (baked into web build)
#SLACK_WEBHOOK_URL=               # #prod-alerts incoming webhook
#LOG_LEVEL=info

# ── DB pool tunables (code defaults are fine) ────────────────────────
#DB_POOL_MAX=
#DB_POOL_IDLE_TIMEOUT=
#DB_POOL_CONNECT_TIMEOUT=
