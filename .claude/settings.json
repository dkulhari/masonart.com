{
  "outputStyle": "ELI5",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-test-scope.py\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking test scope"
          }
        ]
      }
    ]
  }
}
